    {"id": "entrance_notice", "label": "掲示板", "wall": {"x": 6, "y": 9, "side": "west"}, "rect": {"x": 0.18, "y": 0.22, "width": 0.64, "height": 0.56}, "art": {"default": "assets/fixtures/notice-board.svg"}, "events": {"click": [{"id": "read", "actions": [{"op": "message", "title": "掲示板", "text": "日に焼けた掲示物が重なっています。紙の端が丸まり、画鋲にも錆が浮いています。"}]}]}},
