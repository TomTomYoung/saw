    {"id": "staff_door", "label": "管理室の鉄扉", "wall": {"x": 6, "y": 1, "side": "north"}, "rect": {"x": 0.1, "y": 0.03, "width": 0.8, "height": 0.97}, "art": {"default": "assets/fixtures/steel-door.svg"}, "events": {"click": [{"id": "examine", "actions": [{"op": "message", "title": "管理室の鉄扉", "text": "重い鉄の扉です。取っ手の周囲だけ塗装が擦れています。この試作では扉の先は未実装です。"}]}]}},
    {"id": "office_window", "label": "曇りガラスの窓", "wall": {"x": 2, "y": 1, "side": "north"}, "rect": {"x": 0.05, "y": 0.1, "width": 0.9, "height": 0.65}, "art": {"default": "assets/fixtures/window.svg"}, "events": {"click": [{"id": "look", "actions": [{"op": "message", "title": "曇りガラスの窓", "text": "汚れた曇りガラスです。外の光は届いていますが、向こう側の様子は分かりません。"}]}]}},
    {"id": "east_window", "label": "東側の窓", "wall": {"x": 10, "y": 1, "side": "north"}, "rect": {"x": 0.05, "y": 0.1, "width": 0.9, "height": 0.65}, "art": {"default": "assets/fixtures/window.svg"}, "events": {"click": [{"id": "look", "actions": [{"op": "message", "title": "東側の窓", "text": "古いアルミ枠の窓です。ゴムの縁が硬化し、隅に埃が溜まっています。"}]}]}},
    {"id": "storage_vent", "label": "倉庫の換気口", "wall": {"x": 3, "y": 9, "side": "south"}, "rect": {"x": 0.2, "y": 0.2, "width": 0.6, "height": 0.5}, "art": {"default": "assets/fixtures/vent.svg"}, "events": {"click": [{"id": "look", "actions": [{"op": "message", "title": "換気口", "text": "羽根の隙間に埃が溜まっています。奥から弱い空気の流れを感じます。"}]}]}},
